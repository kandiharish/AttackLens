  {
    "id": "okta",
    "kind": "identity",
    "name": "Okta System Log",
    "modes": ["events"],
    "fields": [
      {"label": "Okta org URL", "required": true, "key": "base_url", "type": "url", "placeholder": "https://your-org.okta.com"},
